# 1. Usar una imagen base de Linux ligera
FROM debian:bookworm-slim

# 2. Instalar dependencias necesarias para Flutter y Chrome (en modo headless)
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

# 3. Descargar e instalar Flutter SDK (Versión 3.38 o superior)
RUN git clone https://github.com/flutter/flutter.git -b stable /opt/flutter
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"

# 4. Habilitar soporte para Web y precargar artefactos
RUN flutter config --enable-web && \
    flutter doctor

# 5. Configurar el directorio de trabajo
WORKDIR /app

# 6. Copiar archivos de dependencias primero (para aprovechar el caché de capas)
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# 7. Copiar el resto del código (incluyendo tu web_dev_config.yaml)
COPY . .

# 8. Exponer el puerto configurado en tu web_dev_config.yaml
EXPOSE 5200

# 9. Comando para iniciar el servidor de desarrollo
# Nota: Usamos 0.0.0.0 para que sea accesible desde fuera del contenedor
CMD ["flutter", "run", "-d", "web-server", "--web-hostname", "0.0.0.0", "--web-port", "5200"]